OPENWEATHERMAP_API_KEY=

# Meta Graph API - each language publishes via a Facebook Page's linked Instagram
# Business Account. See README.md "Instagram/Facebook publishing setup" for how to get these.
META_EN_PAGE_ID=
META_EN_IG_BUSINESS_ACCOUNT_ID=
META_EN_PAGE_ACCESS_TOKEN=

META_HU_PAGE_ID=
META_HU_IG_BUSINESS_ACCOUNT_ID=
META_HU_PAGE_ACCESS_TOKEN=

# Telegram bot - announces each published Instagram/Facebook post with its link in the
# matching channel. Create a bot via @BotFather, add it as admin to both channels, then
# send a test message in each and check getUpdates to find the chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_EN_CHAT_ID=
TELEGRAM_HU_CHAT_ID=
